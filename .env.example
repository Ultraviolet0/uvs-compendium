# Local Docker Compose overrides only. Never put production credentials here;
# production configuration lives in a private PHP file outside the web root
# (see docs/configuration.md and docs/config.example.php).

# PHP version for the local image. Keep in step with the Hostinger site.
PHP_VERSION=8.3

# Local ports (always bound to 127.0.0.1).
SITE_PORT=8080
TEST_SITE_PORT=8082

{
    "name": "ultraviolet0/uvs-compendium",
    "description": "UV's Compendium: Diablo I and Hellfire calculators, guides, and community publishing.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "~8.3.0 || ~8.4.0",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "bacon/bacon-qr-code": "^3.0",
        "league/commonmark": "^2.7",
        "phpmailer/phpmailer": "^6.10",
        "spomky-labs/otphp": "^11.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Uvs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Uvs\\Tests\\": "tests/php/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "autoloader-suffix": "UvsCompendium",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
